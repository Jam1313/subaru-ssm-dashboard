<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        By chip maker only (no product-id = any product): KKL clones come with all kinds of product ids
        (FT232R/FT231X variants, CH340/CH341, a wiped 0000 on "bricked" FTDI clones). Matching here lets Android
        offer the app when the cable is plugged in and remember the permission ("use by default"), instead of the
        cable working only after a head unit reboot.
    -->
    <!-- FTDI, also Tactrix OpenPort 1.3 (CC48–CC4A) and OpenPort 2.0 (CC4B–CC4D) -->
    <usb-device vendor-id="1027" />
    <!-- WCH CH340 / CH341 -->
    <usb-device vendor-id="6790" />
    <!-- Prolific PL2303 -->
    <usb-device vendor-id="1659" />
    <!-- Silicon Labs CP210x -->
    <usb-device vendor-id="4292" />
</resources>
